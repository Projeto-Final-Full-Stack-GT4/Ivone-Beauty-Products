{
  "name": "ivone-beauty-products",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:cypress": "vite --host 127.0.0.1 --port 4178 --strictPort",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "cy:run": "start-server-and-test dev:cypress http://127.0.0.1:4178 cypress:run",
    "cy:open": "start-server-and-test dev:cypress http://127.0.0.1:4178 cypress:open",
    "cypress:run": "cypress run",
    "cypress:open": "cypress open",
    "coverage:check": "nyc check-coverage --lines 70 --functions 70 --branches 70 --statements 70",
    "coverage:report": "nyc report --reporter=text-summary --reporter=html",
    "test:e2e": "npm run cy:run && npm run coverage:check && npm run coverage:report"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "bootstrap": "^5.3.8",
    "react": "^19.3.1",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@cypress/code-coverage": "^4.1.3",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cypress": "^16.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "nyc": "^18.0.0",
    "start-server-and-test": "^3.0.13",
    "vite": "^8.3.4",
    "vite-plugin-istanbul": "^9.0.1"
  },
  "nyc": {
    "all": true,
    "include": [
      "src/**/*.{js,jsx}"
    ],
    "exclude": [
      "src/data/products.jsx"
    ],
    "extension": [
      ".js",
      ".jsx"
    ],
    "report-dir": "coverage"
  }
}
